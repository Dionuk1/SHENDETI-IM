# Server
PORT=5500

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/healthflow_os

# Seed (local demo accounts)
# Optional: set a stable password used by `npm run seed`
# If omitted, the optional seed script generates a one-run development value without printing it.
SEED_DEFAULT_PASSWORD=
SEED_ADMIN_EMAIL=

SEED_ADMIN_PASSWORD=
SEED_DOCTOR_EMAIL=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=

# Auth
JWT_SECRET=

# One-time protected admin bootstrap (`npm run bootstrap:admin`)
ADMIN_EMAIL=admin@shendeti-im.test
ADMIN_PASSWORD=

# Google Identity Services (OAuth 2.0 Web client ID; public identifier, never add a client secret to frontend code)
GOOGLE_CLIENT_ID=

# AES-256 (32 bytes) for medical data encryption simulation
# Use one of:
# - 64 hex characters
# - base64 encoding of 32 bytes
MEDICAL_AES_KEY=

# ✨ AI FEATURES (Optional - AI works without these, but with enhanced features using Gemini)
# Get free API key from: https://makersuite.google.com/app/apikey
# Install Gemini package: npm install @google/generative-ai
GEMINI_API_KEY=
GEMINI_MODEL=auto

# Fraud Detection & Security
MAX_REQUESTS_PER_MINUTE=60
MAX_FAILED_LOGINS=5
BAN_DURATION_MINUTES=15
ADMIN_IPS=127.0.0.1

# Node Environment
NODE_ENV=development

