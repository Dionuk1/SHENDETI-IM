# Server
PORT=5500

# MongoDB
MONGODB_URI=
MONGO_URI=

# Seed (local demo accounts)
# Optional: set a stable password used by `npm run seed`
# If omitted, the optional seed script generates a one-run development value without printing it.
SEED_DEFAULT_PASSWORD=
SEED_ADMIN_EMAIL=

SEED_ADMIN_PASSWORD=
SEED_DOCTOR_EMAIL=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=

# Auth
JWT_SECRET=

# One-time protected admin bootstrap (`npm run bootstrap:admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AES-256 (32 bytes) for medical data encryption simulation
# Use one of:
# - 64 hex characters
# - base64 encoding of 32 bytes
MEDICAL_AES_KEY=

# Gemini Symptom Checker (optional; rule-based fallback remains available)
GEMINI_API_KEY=
GEMINI_MODEL=

# Production frontend and storage (optional for local development)
FRONTEND_URL=
ALLOWED_ORIGINS=
MEDICAL_STORAGE_DRIVER=
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_MEDICAL_BUCKET_ID=

# Fraud Detection & Security
MAX_REQUESTS_PER_MINUTE=
MAX_FAILED_LOGINS=
BAN_DURATION_MINUTES=
ADMIN_IPS=

# Node Environment
NODE_ENV=

